# Telegram
BOT_TOKEN=your_bot_token_here

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo

# WebApp
WEBAPP_URL=https://yourdomain.com/webapp
API_URL=http://127.0.0.1:8000

# Security (validate Telegram initData)
SECRET_KEY=your_secret_key_here

# Database (постоянное хранилище)
DATA_DIR=/data
DATABASE_URL=sqlite+aiosqlite:////data/mama_bot.db
LOG_DIR=/data/logs

# Logging
LOG_LEVEL=INFO
